<?xml version="1.0"?>
<!-- 前置 RGB 摄像头：gz-sim camera 传感器，桥接 /camera/image_raw(+compressed) -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="amr_camera" params="tf_prefix:='' parent:='top_link'">

    <link name="${tf_prefix}camera_link">
      <visual>
        <geometry>
          <box size="0.03 0.08 0.03"/>
        </geometry>
        <material name="camera_black">
          <color rgba="0.1 0.0 0.0 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="0.03 0.08 0.03"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.05"/>
        <inertia ixx="0.00001" ixy="0.0" ixz="0.0"
                 iyy="0.00001" iyz="0.0" izz="0.00001"/>
      </inertial>
    </link>

    <!-- 光学坐标系：z 朝前、x 朝右、y 朝下（ROS 相机约定） -->
    <link name="${tf_prefix}camera_optical_link"/>
    <joint name="${tf_prefix}camera_optical_joint" type="fixed">
      <parent link="${tf_prefix}camera_link"/>
      <child link="${tf_prefix}camera_optical_link"/>
      <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
    </joint>

    <joint name="${tf_prefix}camera_joint" type="fixed">
      <parent link="${tf_prefix}${parent}"/>
      <child link="${tf_prefix}camera_link"/>
      <!-- 贴在 top_link 前壁(x=0.15)正面：箱体深 0.03，中心 x=0.15+0.015=0.165，后壁贴壁；z=0 居正面中部 -->
      <origin xyz="0.165 0.0 0.0" rpy="0 0 0"/>
    </joint>

    <gazebo reference="${tf_prefix}camera_link">
      <sensor name="rgb_camera" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <topic>camera/image_raw</topic>
        <gz_frame_id>${tf_prefix}camera_optical_link</gz_frame_id>
        <!-- 软件渲染（llvmpipe）下摄像头是主要渲染负载，且与 gpu_lidar 共用
             ogre2 渲染队列：640×480@15Hz 曾拖垮渲染管线，导致 /scan 时间戳
             持续滞后 /clock（SLAM 发散根因）。降为 320×240@5Hz，
             像素吞吐降 16 倍，巡检/识别用途仍可用。 -->
        <update_rate>5</update_rate>
        <always_on>true</always_on>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>30.0</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>

  </xacro:macro>
</robot>
