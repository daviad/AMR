<?xml version="1.0"?>
<!-- 2D 激光雷达：gz-sim gpu_lidar 传感器，话题由 ros_gz_bridge 桥到 /scan -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="amr_lidar" params="tf_prefix:='' parent:='base_link'">

    <link name="${tf_prefix}lidar_link">
      <visual>
        <geometry>
          <cylinder radius="0.05" length="0.06"/>
        </geometry>
        <material name="blue">
          <color rgba="0.1 0.3 0.8 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="0.05" length="0.06"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.2"/>
        <inertia ixx="0.0002" ixy="0.0" ixz="0.0"
                 iyy="0.0002" iyz="0.0" izz="0.0004"/>
      </inertial>
    </link>
    <joint name="${tf_prefix}lidar_joint" type="fixed">
      <parent link="${tf_prefix}${parent}"/>
      <child link="${tf_prefix}lidar_link"/>
      <!-- top_link 顶面在自身坐标 z=0.04；lidar 柱高 0.06，中心置于 0.04+0.03=0.07，使底面落于顶面 -->
      <origin xyz="0.0 0.0 0.07" rpy="0 0 0"/>
    </joint>

    <!-- gz-sim gpu_lidar 传感器（ogre2 渲染深度图实现）。
         工程决策：gz-sim8 的 sensors 系统不支持 CPU lidar（二进制仅含 GpuLidarSensor），
         只能用 gpu_lidar。软件渲染（llvmpipe）下渲染吞吐有限，曾出现 scan 时间戳
         持续滞后 /clock（4s→16s 单调增长），破坏 Cartographer 时间对齐。
         对策：360×1 的 lidar 深度图渲染本身极廉价，主要负载来自 640×480@15Hz 摄像头；
         已将摄像头降为 320×240@5Hz（amr_camera.xacro），渲染负载降 ~16 倍。
         注意：lidar_link 自身碰撞柱半径 0.05 < min_range 0.12，自遮挡被滤除。 -->
    <gazebo reference="${tf_prefix}lidar_link">
      <sensor name="gpu_lidar" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <topic>scan</topic>
        <gz_frame_id>${tf_prefix}lidar_link</gz_frame_id>
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.1415926</min_angle>
              <max_angle>3.1415926</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.12</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
        <always_on>true</always_on>
        <visualize>false</visualize>
      </sensor>
    </gazebo>

  </xacro:macro>
</robot>
