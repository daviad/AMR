<?xml version="1.0"?>
<!-- 室内巡检场景：围墙 + 房间分隔 + 障碍物 + 充电桩标记区 -->
<sdf version="1.9">
  <world name="indoor">

    <!-- 物理引擎 -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- 场景插件 -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <!-- 注意：不要在 world 中定义 <gui> 段。gz-sim 8.15 从 world <gui> 段加载
         MinimalScene 时会丢失渲染引擎名（以空名调用 RenderEngineManager），
         导致 GUI 窗口弹出但 3D 视口空白。删除本段后走 ~/.gz/sim/8/gui.config
         默认布局（其中 MinimalScene 显式 engine=ogre2），渲染正常。 -->

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- 地面 -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <!-- 地面摩擦：配合轮摩擦与 max_wheel_torque，
               使撞墙时轮子打滑而非完美空转，避免轮式里程计累积巨大漂移 -->
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 围墙（10m x 8m 区域，墙高 0.5m 厚 0.1m） -->
    <!-- 北墙 y=4 -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 4.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>10.2 0.1 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>10.2 0.1 0.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- 南墙 y=-4 -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -4.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>10.2 0.1 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>10.2 0.1 0.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- 东墙 x=5 -->
    <model name="wall_east">
      <static>true</static>
      <pose>5.0 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 8.2 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 8.2 0.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- 西墙 x=-5 -->
    <model name="wall_west">
      <static>true</static>
      <pose>-5.0 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 8.2 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 8.2 0.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 房间分隔：x=1 处纵墙（y 从 0.5 到 4，留出 y<0.5 的门洞） -->
    <model name="partition_v1">
      <static>true</static>
      <pose>1.0 2.25 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 3.5 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 3.5 0.5</size></box></geometry>
          <material><ambient>0.8 0.8 0.75 1</ambient><diffuse>0.8 0.8 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- 房间分隔：y=0 处横墙（x 从 -5 到 -2，留出 x>-2 的门洞） -->
    <model name="partition_h1">
      <static>true</static>
      <pose>-3.5 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>3.0 0.1 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.0 0.1 0.5</size></box></geometry>
          <material><ambient>0.8 0.8 0.75 1</ambient><diffuse>0.8 0.8 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 障碍物：箱子 x3 -->
    <model name="box_1">
      <static>true</static>
      <pose>-2.0 2.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="box_2">
      <static>true</static>
      <pose>2.5 -1.5 0.25 0 0 0.3</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- 障碍物：圆柱 -->
    <model name="cylinder_1">
      <static>true</static>
      <pose>3.0 2.5 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.25</radius><length>0.6</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.25</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>0.2 0.5 0.6 1</ambient><diffuse>0.2 0.5 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="cylinder_2">
      <static>true</static>
      <pose>-1.0 -2.5 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.25</radius><length>0.6</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.25</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>0.2 0.5 0.6 1</ambient><diffuse>0.2 0.5 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 正前方彩色障碍物（摄像头视野内容） -->
    <model name="front_box_red">
      <static>true</static>
      <pose>2.5 0.0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.6 0.6 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 0.6 0.8</size></box></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="front_box_green">
      <static>true</static>
      <pose>2.5 1.2 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 0.5 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.5 0.5 0.6</size></box></geometry>
          <material><ambient>0.1 0.7 0.2 1</ambient><diffuse>0.1 0.7 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="front_box_blue">
      <static>true</static>
      <pose>2.5 -1.2 0.35 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 0.5 0.7</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.5 0.5 0.7</size></box></geometry>
          <material><ambient>0.1 0.3 0.8 1</ambient><diffuse>0.1 0.3 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 充电桩标记区（西南角，黄色地面标记 + 小立柱） -->
    <model name="charge_dock_marker">
      <static>true</static>
      <pose>-4.4 -3.4 0.001 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.8 0.8 0.002</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.8 0.8 0.002</size></box></geometry>
          <material><ambient>1.0 0.9 0.1 1</ambient><diffuse>1.0 0.9 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="charge_dock_post">
      <static>true</static>
      <pose>-4.7 -3.4 0.35 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 0.4 0.7</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 0.4 0.7</size></box></geometry>
          <material><ambient>0.1 0.6 0.1 1</ambient><diffuse>0.1 0.6 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
